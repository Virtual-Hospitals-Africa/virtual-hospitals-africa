FROM denoland/deno:2.8.0
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates postgresql-client && rm -rf /var/lib/apt/lists/*
RUN touch .env

# .git is excluded from the build context (see .dockerignore), so the commit
# must be passed in explicitly, e.g. --build-arg GIT_COMMIT=$(git rev-parse HEAD)
ARG GIT_COMMIT
ENV GIT_COMMIT=${GIT_COMMIT}

COPY deno.lock ./
COPY deno.json ./
RUN deno install --allow-scripts

COPY db.d.ts ./
COPY types.ts ./
COPY db/ ./db/
COPY util/ ./util/
COPY shared/ ./shared/
COPY s_expression/ ./s_expression/
COPY test/_helpers/organizations.ts ./test/_helpers/
COPY external-clients/google-maps.ts ./external-clients/
COPY backend/predefinedAvatarMediaUUID.ts ./backend/

CMD ["sh", "-c", "deno task db:restore snomed && deno task db:migrate all"]