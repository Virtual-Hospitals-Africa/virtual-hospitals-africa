 "rules": [
  {
   "rule": "Diagnose probable acute coronary syndrome in chest pain",
   "verdict": "problem",
   "severity": "high",
   "problem": "The \"Is chest pain/discomfort any of\" list leaves out two of the page's five features: \"Not relieved by rest or sublingual nitrates\" and \"Occurs more often than usual\". It also drops \"with minimal effort\". A patient known with stable angina whose pain is crescendo or not relieved by nitrates is therefore sent down the stable-angina path, not ACS. The rest of the structure matches the flowchart: (ECG abnormal OR no to positional pain) AND (any feature OR not known stable angina)."
  },
  {
   "rule": "Diagnose probable stable angina in chest pain",
   "verdict": "problem",
   "severity": "high",
   "problem": "This mirrors the ACS gap: it doesn't exclude pain that is not relieved by rest or nitrates, or that occurs more often than usual, so it fires for presentations the page calls ACS. At exactly 10 minutes it overlaps with the ACS rule (<= vs >=). \"Patient has stable angina\" is a definite statement, so probable is acceptable."
  },
  {
   "rule": "Check chest pain character for acute coronary syndrome",
   "verdict": "problem",
   "severity": "medium",
   "problem": "The check_for leaves out \"not relieved by rest or sublingual nitrates\", \"occurs more often than usual\" and the minimal-effort half of \"occurs at rest\". The health worker is never asked for two of the five ACS discriminators."
  },
  {
   "rule": "Check for urgent chest pain signs",
   "verdict": "ok",
   "severity": "low",
   "problem": "Covers the red-box list. The only gap is the site-less \"Chest discomfort\" + New."
  },
  {
   "rule": "Record known cardiovascular disease risk for chest pain",
   "verdict": "ok",
   "severity": "low",
   "problem": "The page says \"known CVD risk > 20%\", not that the risk should be measured. The measure task is a reasonable way to capture it as evidence."
  },
  {
   "rule": "Do an ECG for chest pain (doctor to review)",
   "verdict": "ok",
   "severity": "low",
   "problem": ""
  },
  {
   "rule": "Check for tension pneumothorax or pneumonia in chest pain",
   "verdict": "ok",
   "severity": "low",
   "problem": "The trigger correctly matches the Yes branch of the positional-pain question. Temperature is a routine vital, so it is rightly left out."
