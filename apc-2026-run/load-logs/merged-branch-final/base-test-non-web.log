select
  "snomed_concept"."id"::text as "id",
  "snomed_inferred_canonical_name_and_category"."name",
  "snomed_inferred_canonical_name_and_category"."category",
  "snomed_concept"."active",
  (
    select
      coalesce(json_agg(agg), '[]')
    from
      (
        select
          "snomed_description"."id"::text as "id",
          "snomed_description"."term",
          "snomed_description"."language_code",
          "snomed_description"."type_id"::text as "type_id"
        from
          "snomed_description"
        where
          "snomed_description"."concept_id" = "snomed_concept"."id"
          and "snomed_description"."active" = true
        order by
          "snomed_description"."term"
      ) as agg
  ) as "descriptions",
  (
    select
      coalesce(json_agg(agg), '[]')
    from
      (
        select
          "snomed_text_definition"."id"::text as "id",
          "snomed_text_definition"."term",
          "snomed_text_definition"."language_code"
        from
          "snomed_text_definition"
        where
          "snomed_text_definition"."concept_id" = "snomed_concept"."id"
          and "snomed_text_definition"."active" = true
        order by
          "snomed_text_definition"."language_code"
      ) as agg
  ) as "text_definitions",
  (
    select
      coalesce(json_agg(agg), '[]')
    from
      (
        select
          "snomed_relationship"."id"::text as "id",
          "snomed_relationship"."relationship_group",
          "snomed_relationship"."type_id"::text as "type_id",
          "rel_type"."name" as "type_name",
          "snomed_relationship"."destination_id"::text as "destination_id",
          "rel_dest"."name" as "destination_name",
          "rel_dest"."category" as "destination_category"
        from
          "snomed_relationship"
          inner join "snomed_inferred_canonical_name_and_category" as "rel_type" on "rel_type"."id" = "snomed_relationship"."type_id"
          inner join "snomed_inferred_canonical_name_and_category" as "rel_dest" on "rel_dest"."id" = "snomed_relationship"."destination_id"
        where
          "snomed_relationship"."source_id" = "snomed_concept"."id"
          and "snomed_relationship"."active" = true
        order by
          "snomed_relationship"."relationship_group",
          "rel_type"."name"
      ) as agg
  ) as "relationships",
  (
    select
      coalesce(json_agg(agg), '[]')
    from
      (
        select
          "snomed_stated_relationship"."id"::text as "id",
          "snomed_stated_relationship"."relationship_group",
          "snomed_stated_relationship"."type_id"::text as "type_id",
          "sr_type"."name" as "type_name",
          "snomed_stated_relationship"."destination_id"::text as "destination_id",
          "sr_dest"."name" as "destination_name",
          "sr_dest"."category" as "destination_category"
        from
          "snomed_stated_relationship"
          inner join "snomed_inferred_canonical_name_and_category" as "sr_type" on "sr_type"."id" = "snomed_stated_relationship"."type_id"
          inner join "snomed_inferred_canonical_name_and_category" as "sr_dest" on "sr_dest"."id" = "snomed_stated_relationship"."destination_id"
        where
          "snomed_stated_relationship"."source_id" = "snomed_concept"."id"
          and "snomed_stated_relationship"."active" = true
        order by
          "snomed_stated_relationship"."relationship_group",
          "sr_type"."name"
      ) as agg
  ) as "stated_relationships",
  (
    select
      coalesce(json_agg(agg), '[]')
    from
      (
        select
          "snomed_relationship_concrete_values"."id"::text as "id",
          "snomed_relationship_concrete_values"."relationship_group",
          "snomed_relationship_concrete_values"."type_id"::text as "type_id",
          "cv_type"."name" as "type_name",
          "snomed_relationship_concrete_values"."value"
        from
          "snomed_relationship_concrete_values"
          inner join "snomed_inferred_canonical_name_and_category" as "cv_type" on "cv_type"."id" = "snomed_relationship_concrete_values"."type_id"
        where
          "snomed_relationship_concrete_values"."source_id" = "snomed_concept"."id"
          and "snomed_relationship_concrete_values"."active" = true
        order by
          "snomed_relationship_concrete_values"."relationship_group",
          "cv_type"."name"
      ) as agg
  ) as "concrete_values"
from
  "snomed_concept"
  inner join "snomed_inferred_canonical_name_and_category" on "snomed_inferred_canonical_name_and_category"."id" = "snomed_concept"."id"
where
  "snomed_inferred_canonical_name_and_category"."category" = 'substance'
  and 'gar' <% snomed_inferred_canonical_name_and_category.name
  and "snomed_concept"."active" = true
order by
  similarity (
    'gar',
    snomed_inferred_canonical_name_and_category.name
  ) desc
