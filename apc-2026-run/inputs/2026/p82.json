   "page": 82,
   "box": 1,
   "kind_hint": "management",
   "section": "Manage and refer urgently:",
   "section_y": 198.5,
   "indent": 1,
   "parent": null,
   "text": "If shock/SBP < 80, give sodium chloride 0.9% 500mL IV over 30 minutes, repeat until systolic BP > 80. Continue 1L 6 hourly. Stop if breathing worsens.",
   "bbox": [
    51.2,
    208.7,
    533.6,
    229.5
   ],
   "key": "p82-de931597"
  },
  {
   "id": "p82-rb1-e16",
   "page": 82,
   "box": 1,
   "kind_hint": "management",
   "section": "Manage and refer urgently:",
   "section_y": 198.5,
   "indent": 1,
   "parent": null,
   "text": "If meningococcal disease likely: give ceftriaxone3 2g IM. Avoid injecting > 1g IM at one injection site.",
   "bbox": [
    51.2,
    228.5,
    447.8,
    239.5
   ],
   "key": "p82-05f5a05b"
  },
