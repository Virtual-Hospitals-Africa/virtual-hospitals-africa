  {
   "id": "p88-rb1-e15",
   "page": 88,
   "box": 1,
   "kind_hint": "management",
   "section": "Manage and refer urgently:",
   "section_y": 210.0,
   "indent": 1,
   "parent": null,
   "text": "If shock/SBP < 80, give sodium chloride 0.9% 500mL IV over 30 minutes, repeat until systolic BP > 80. Continue 1L 6 hourly. Stop if breathing worsens.",
   "bbox": [
    51.2,
    230.4,
    631.5,
    241.2
   ],
