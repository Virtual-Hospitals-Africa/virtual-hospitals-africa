   "page": 63,
   "box": 0,
   "kind_hint": "outside",
   "section": null,
   "section_y": -1,
   "indent": 0,
   "parent": null,
   "text": "• If poor adherence, repeat treatment. • If adherent and still no better, refer.",
   "bbox": [
    567.1,
    501.9,
    705.6,
    522.1
   ],
   "key": "p63-9a25cddd"
  },
  {
