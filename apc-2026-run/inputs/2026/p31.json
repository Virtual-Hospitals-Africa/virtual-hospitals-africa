  },
  {
   "id": "p31-rb1-e36",
   "page": 31,
   "box": 1,
   "kind_hint": "other",
   "section": "How to calculate %TBSA of burn",
   "section_y": 133.1,
   "indent": 0,
   "parent": null,
   "text": "9%",
   "bbox": [
    580.6,
    288.0,
    591.3,
    297.5
   ],
   "key": "p31-79746519"
  },
  {
   "id": "p31-rb1-e37",
   "page": 31,
   "box": 1,
   "kind_hint": "management",
   "section": "Manage and refer urgently:",
   "section_y": 189.2,
   "indent": 2,
   "parent": "p31-rb1-e23",
   "text": "Insert a urinary catheter and document urine output every hour.",
   "bbox": [
    57.1,
    299.4,
    307.0,
    310.2
   ],
   "key": "p31-4b439d55"
  },
  {
   "id": "p31-rb1-e38",
   "page": 31,
   "box": 1,
   "kind_hint": "management",
   "section": "Manage and refer urgently:",
   "section_y": 189.2,
   "indent": 1,
   "parent": null,
   "text": "Give paracetamol 500mg-1g orally 4-6 hourly (max 4g/24 hours). If pain severe, give morphine 3-10mg slow IV2.",
   "bbox": [
    51.4,
    309.4,
    484.9,
    320.2
   ],
   "key": "p31-9e591667"
  },
  {
   "id": "p31-rb1-e39",
   "page": 31,
   "box": 1,
   "kind_hint": "management",
   "section": "Manage and refer urgently:",
   "section_y": 189.2,
   "indent": 1,
   "parent": null,
   "text": "If other injuries, manage 30.",
   "bbox": [
    51.4,
    319.4,
    173.5,
    330.2
   ],
   "key": "p31-f8ec9f63"
  },
  {
   "id": "p31-rb1-e40",
   "page": 31,
   "box": 1,
   "kind_hint": "management",
   "section": "Manage and refer urgently:",
   "section_y": 189.2,
   "indent": 1,
   "parent": null,
   "text": "Clean and dress burn gently:",
   "bbox": [
    51.4,
    329.4,
    168.2,
    340.2
   ],
   "key": "p31-fcd562e6"
  },
  {
   "id": "p31-rb1-e41",
   "page": 31,
   "box": 1,
   "kind_hint": "management",
   "section": "Manage and refer urgently:",
   "section_y": 189.2,
   "indent": 2,
   "parent": "p31-rb1-e40",
   "text": "Remove loose/dead skin and clean burn with chlorhexidine 0.05% or sodium chloride 0.9%.",
   "bbox": [
    57.1,
    339.4,
    424.4,
    350.2
   ],
   "key": "p31-fe043c49"
  },
  {
   "id": "p31-rb1-e42",
   "page": 31,
   "box": 1,
   "kind_hint": "management",
   "section": "Manage and refer urgently:",
   "section_y": 189.2,
   "indent": 2,
   "parent": "p31-rb1-e40",
   "text": "If full thickness or > 10% TBSA burn, apply paraffin gauze and cover with plastic wrap.",
   "bbox": [
    57.1,
    349.4,
    387.4,
    360.2
   ],
   "key": "p31-e1ece3e5"
  },
  {
   "id": "p31-rb1-e43",
   "page": 31,
   "box": 1,
   "kind_hint": "management",
   "section": "Manage and refer urgently:",
   "section_y": 189.2,
   "indent": 2,
   "parent": "p31-rb1-e40",
   "text": "If hospital transfer delayed > 12 hours, apply paraffin gauze and cover with dry gauze and bandage.",
   "bbox": [
    57.1,
    359.4,
    441.1,
    370.2
   ],
   "key": "p31-f0b31314"
  },
  {
   "id": "p31-rb1-e44",
   "page": 31,
   "box": 1,
   "kind_hint": "management",
   "section": "Manage and refer urgently:",
   "section_y": 189.2,
   "indent": 2,
   "parent": "p31-rb1-e40",
   "text": "If none of above, apply hydrogel burn dressing (e.g. Burnshield®) and cover with bandage. If not available, use a non-adherent dressing or wrap in clean, dry sheet and blanket.",
   "bbox": [
    57.1,
    369.4,
    488.1,
    390.2
   ],
   "key": "p31-e098770c"
  },
  {
   "id": "p31-rb1-e45",
   "page": 31,
   "box": 1,
   "kind_hint": "other",
   "section": "How to calculate %TBSA of burn",
   "section_y": 133.1,
   "indent": 0,
   "parent": null,
   "text": "The patient's open palm (including fingers) represents 1% TBSA.",
   "bbox": [
    550.0,
    385.5,
    748.0,
    394.0
   ],
   "key": "p31-2633a01f"
  },
  {
   "id": "p31-rb1-e46",
   "page": 31,
   "box": 1,
   "kind_hint": "management",
   "section": "Manage and refer urgently:",
   "section_y": 189.2,
   "indent": 1,
   "parent": null,
   "text": "Give tetanus toxoid 0.5mL IM if none in past 5 years.",
   "bbox": [
    51.4,
    389.4,
    262.0,
    400.2
   ],
   "key": "p31-733939d4"
  },
  {
   "id": "p31-rb1-e47",
   "page": 31,
   "box": 1,
   "kind_hint": "other",
