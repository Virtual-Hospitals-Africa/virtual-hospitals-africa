  },
  {
   "id": "p31-rb1-e29",
   "page": 31,
   "box": 1,
   "kind_hint": "management",
   "section": "Manage and refer urgently:",
   "section_y": 189.2,
   "indent": 2,
   "parent": "p31-rb1-e23",
   "text": "If > 10% TBSA:",
   "bbox": [
    57.1,
    259.4,
    118.0,
    270.2
   ],
   "key": "p31-798dad6b"
  },
  {
   "id": "p31-rb1-e30",
   "page": 31,
   "box": 1,
   "kind_hint": "management",
   "section": "Manage and refer urgently:",
   "section_y": 189.2,
   "indent": 3,
   "parent": "p31-rb1-e29",
   "text": "If shock1/systolic BP < 80, give sodium chloride 0.9% 1L IV rapidly. Repeat until systolic BP > 80.",
   "bbox": [
    62.7,
    269.4,
    433.8,
    280.2
   ],
   "key": "p31-00270aee"
  },
  {
   "id": "p31-rb1-e31",
   "page": 31,
   "box": 1,
   "kind_hint": "other",
   "section": "How to calculate %TBSA of burn",
   "section_y": 133.1,
   "indent": 0,
   "parent": null,
   "text": "1%",
   "bbox": [
    570.5,
    268.6,
    579.9,
    276.9
   ],
   "key": "p31-743363fd"
  },
  {
   "id": "p31-rb1-e32",
   "page": 31,
   "box": 1,
   "kind_hint": "management",
   "section": "Manage and refer urgently:",
   "section_y": 189.2,
   "indent": 3,
   "parent": "p31-rb1-e29",
   "text": "Also give sodium chloride 0.9% IV 4mL x weight (kg) x % TBSA over 24 hours. Give half this volume in first 8 hours from time of burn. Calculate the hourly volume (mL) = total volume (mL) ÷ 2 ÷ 8.",
   "bbox": [
    62.7,
    279.4,
    475.0,
    300.2
   ],
   "key": "p31-72e8d62e"
  },
  {
