  },
  {
   "id": "p31-rb1-e22",
   "page": 31,
   "box": 1,
   "kind_hint": "management",
   "section": "Manage and refer urgently:",
   "section_y": 189.2,
   "indent": 1,
   "parent": null,
   "text": "Remove clothing. Cool burn with cool tap water or wet towel/s for 30 minutes. Keep warm with clean, dry sheet.",
   "bbox": [
    51.4,
    219.4,
    483.5,
    230.2
   ],
   "key": "p31-c82dfa7b"
  },
  {
   "id": "p31-rb1-e23",
   "page": 31,
   "box": 1,
   "kind_hint": "management",
   "section": "Manage and refer urgently:",
   "section_y": 189.2,
   "indent": 1,
   "parent": null,
   "text": "Give IV fluids:",
   "bbox": [
    51.4,
    229.4,
    108.2,
    240.2
   ],
   "key": "p31-4e067d7d"
  },
  {
   "id": "p31-rb1-e24",
   "page": 31,
   "box": 1,
   "kind_hint": "management",
   "section": "Manage and refer urgently:",
   "section_y": 189.2,
   "indent": 2,
   "parent": "p31-rb1-e23",
   "text": "Insert a large-bore IV line. If % TBSA burnt > 40% or if transport to hospital likely to take more than 45 minutes, insert a second IV line.",
   "bbox": [
    57.1,
    239.4,
    484.9,
    260.2
   ],
   "key": "p31-ddf6c629"
  },
