   "box": 1,
   "kind_hint": "management",
   "section": "Manage and refer urgently:",
   "section_y": 189.2,
   "indent": 1,
   "parent": null,
   "text": "Assess and manage airway, breathing and circulation 16. Give face mask oxygen if burn > 10% TBSA, inhalation injury, oxygen saturation < 94% or drowsy/confused. Doctor to assess need for intubation.",
   "bbox": [
    51.4,
    199.4,
    450.5,
