   "section_y": -1,
   "indent": 0,
   "parent": null,
   "text": "Atrial fibrillation (AF) (irregular rate, absent ‘p-waves’)",
   "bbox": [
    610.9,
    286.3,
    726.0,
    307.3
   ],
   "key": "p26-5ec1a727"
  },
