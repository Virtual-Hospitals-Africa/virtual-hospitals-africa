   "box": 0,
   "kind_hint": "outside",
   "section": null,
   "section_y": -1,
   "indent": 0,
   "parent": null,
   "text": "Check for fever, dehydration, anaemia, pregnancy and medication side effects",
   "bbox": [
    171.8,
    341.6,
    457.9,
    351.8
   ],
   "key": "p26-fa0da578"
  },
  {
