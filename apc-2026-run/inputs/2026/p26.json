   "box": 0,
   "kind_hint": "outside",
   "section": null,
   "section_y": -1,
   "indent": 0,
   "parent": null,
   "text": "• Review patient's prescribed and over- the-counter medication1 to check if any are known to prolong QT interval2. • Consider switch/stop medication. If unsure, discuss.",
   "bbox": [
    430.2,
    367.1,
    583.5,
    417.3
   ],
