   "page": 26,
   "box": 1,
   "kind_hint": "management",
   "section": "Manage and refer urgently:",
   "section_y": 172.9,
   "indent": 1,
   "parent": null,
   "text": "Assess and manage airway, breathing and circulation 16. If oxygen saturation < 94%, oxygen saturation machine not available, respiratory rate ≥ 30 or difficulty breathing, give face mask oxygen to maintain saturation ≥ 94%.",
   "bbox": [
    51.2,
    183.1,
    774.9,
    203.9
