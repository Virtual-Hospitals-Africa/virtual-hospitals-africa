   "kind_hint": "outside",
   "section": null,
   "section_y": -1,
   "indent": 0,
   "parent": null,
   "text": "If woman of child bearing potential, do urine",
   "bbox": [
    339.0,
    367.1,
    408.6,
    397.3
   ],
   "key": "p26-4ce98263"
