   "page": 26,
   "box": 0,
   "kind_hint": "outside",
   "section": null,
   "section_y": -1,
   "indent": 0,
   "parent": null,
   "text": "If none of the above, consider thyroid or electrolyte abnormalities. Check TSH, potassium, magnesium and manage according to result.",
   "bbox": [
    67.5,
    432.5,
    560.2,
    442.7
   ],
   "key": "p26-b734420c"
  },
  {
