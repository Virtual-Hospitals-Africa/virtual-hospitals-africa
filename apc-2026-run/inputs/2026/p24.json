    422.9
   ],
   "key": "p24-e747a4d3"
  },
  {
   "id": "p24-rb1-e48",
   "page": 24,
   "box": 1,
   "kind_hint": "management",
   "section": "Manage and refer urgently:",
   "section_y": 220.1,
   "indent": 5,
   "parent": null,
   "text": "If BP > 180/130, give single dose amlodipine 10mg orally.",
   "bbox": [
    659.9,
    420.3,
    785.4,
    441.1
   ],
   "key": "p24-4dda70d1"
  },
  {
   "id": "p24-rb1-e49",
   "page": 24,
   "box": 1,
   "kind_hint": "criterion",
   "section": "Is chest pain/discomfort any of:",
   "section_y": 220.1,
   "indent": 3,
   "parent": "p24-rb1-e47",
   "text": "If no ST elevation or left bundle branch block, or unsure, discuss with specialist or referral hospital. If ongoing chest pain, repeat ECG.",
   "bbox": [
    61.0,
    422.1,
    571.3,
    432.9
   ],
   "key": "p24-f39d446e"
  },
  {
   "id": "p24-rb1-e50",
   "page": 24,
   "box": 1,
   "kind_hint": "criterion",
   "section": "Is chest pain/discomfort any of:",
   "section_y": 220.1,
   "indent": 3,
   "parent": "p24-rb1-e47",
   "text": "Give streptokinase only if ECG shows ST elevation3 or left bundle branch block and if ≤ 6 hours since maximal chest pain. If > 6hrs since maximal chest pain or ongoing pain, discuss streptokinase with specialist or referral hospital.",
   "bbox": [
    61.0,
    432.1,
    559.1,
    452.9
   ],
   "key": "p24-67d96111"
  },
  {
   "id": "p24-rb1-e51",
   "page": 24,
   "box": 1,
   "kind_hint": "management",
   "section": "Manage and refer urgently:",
   "section_y": 220.1,
   "indent": 5,
   "parent": null,
   "text": "If chest pain worse on breathing deeply, coughing sputum and temperature ≥ 38°C, pneumonia likely: give ceftriaxone 1g IV6/IM.",
   "bbox": [
    659.9,
    440.3,
    784.4,
    491.1
   ],
   "key": "p24-ecb7c55a"
  },
  {
   "id": "p24-rb1-e52",
   "page": 24,
   "box": 1,
   "kind_hint": "criterion",
   "section": "Is chest pain/discomfort any of:",
   "section_y": 220.1,
   "indent": 3,
   "parent": "p24-rb1-e47",
   "text": "Avoid if streptokinase given in past year4 or known allergy to it, stroke in past 3 months, recent major trauma, major surgery in past month, active bleeding, known bleeding disorder, aneurysm or aortic dissection. Discuss with specialist/referral hospital if any of: warfarin treatment, recent retinal laser treatment, subclavian central line, pregnant, TIA in past 6 months or unsure.",
   "bbox": [
    61.0,
    452.1,
    566.4,
    482.9
   ],
   "key": "p24-f0dc7bcd"
  },
  {
   "id": "p24-rb1-e53",
   "page": 24,
   "box": 1,
   "kind_hint": "criterion",
   "section": "Is chest pain/discomfort any of:",
   "section_y": 220.1,
   "indent": 3,
   "parent": "p24-rb1-e47",
   "text": "Give streptokinase 1.5 million IU diluted in 100mL sodium chloride 0.9% IV over 30-60 minutes.",
   "bbox": [
    61.0,
    482.1,
    441.5,
    492.9
   ],
   "key": "p24-92d49f7e"
  },
  {
   "id": "p24-rb1-e54",
   "page": 24,
   "box": 1,
   "kind_hint": "criterion",
   "section": "Is chest pain/discomfort any of:",
   "section_y": 220.1,
   "indent": 3,
   "parent": "p24-rb1-e47",
   "text": "Monitor BP: if < 90/60, slow rate of infusion (avoid stopping it). Aim to complete infusion in under 60 minutes.",
   "bbox": [
    61.0,
    492.1,
    483.3,
    502.9
   ],
   "key": "p24-39d9e0e9"
  },
  {
