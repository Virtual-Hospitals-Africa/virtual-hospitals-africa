   "box": 0,
   "kind_hint": "outside",
   "section": null,
   "section_y": -1,
   "indent": 0,
   "parent": null,
   "text": "5% ointment once a day or - Apply betamethasone 0.1%",
   "bbox": [
    487.7,
    407.6,
    604.7,
    428.5
   ],
   "key": "p93-88336a17"
  },
  {
