   "kind_hint": "outside",
   "section": null,
   "section_y": -1,
   "indent": 0,
   "parent": null,
   "text": "for 3 days. • Refer same day if: - Eye, ear or nose involvement - Suspected meningitis (headache, temperature ≥ 38°C, neck stiffness) - Rash involves more than one region of the body.",
   "bbox": [
    535.7,
    480.3,
    797.2,
    530.5
