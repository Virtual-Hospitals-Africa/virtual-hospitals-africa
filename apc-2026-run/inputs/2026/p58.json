   "page": 58,
   "box": 0,
   "kind_hint": "outside",
   "section": null,
   "section_y": -1,
   "indent": 0,
   "parent": null,
   "text": "Dysentery likely • Give ciprofloxacin 500mg 12 hourly for 3 days. • If no response within 3 days, refer.",
