   "section_y": -1,
   "indent": 0,
   "parent": null,
   "text": "Does patient have any of: heart disease, hypertension, asthma, diabetes, anaemia, bleeding disorder, epilepsy, substance abuse or large fibroids?",
   "bbox": [
