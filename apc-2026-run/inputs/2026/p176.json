   "box": 0,
   "kind_hint": "outside",
   "section": null,
   "section_y": -1,
   "indent": 0,
   "parent": null,
   "text": "If > 9 weeks • If MVA/resuscitation equipment not available, refer to another facility for supervised medical TOP. • If MVA/resuscitation equipment available, offer supervised medical TOP:",
   "bbox": [
