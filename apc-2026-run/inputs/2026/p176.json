   "section": null,
   "section_y": -1,
   "indent": 0,
   "parent": null,
   "text": "TOP/MVA • If MVA/resuscitation equipment not available, refer to another facility for surgical TOP. • Give single dose misoprostol 400mcg vaginally 3 hours before procedure. • For pain during MVA: - Give morphine 0.1mg/",
   "bbox": [
    573.5,
    229.6,
    676.2,
    339.8
   ],
   "key": "p176-a21116f2"
  },
